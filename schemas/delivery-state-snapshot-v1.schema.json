{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recordstracker.example/schemas/delivery-state-snapshot-v1.schema.json",
  "title": "RecordsTracker delivery-state snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "repository", "issue", "git", "branch_ownership", "pull_request", "changed_files", "checks", "worktrees", "stash_protections", "classifications", "freshness", "next_legal_states", "prohibited_actions", "sources"],
  "properties": {
    "schema_version": {"const": "recordstracker.delivery-state.v1"},
    "generated_at": {"$ref": "#/$defs/time"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["owner", "name", "canonical_identity", "remote_url_classification"], "properties": {"owner": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "canonical_identity": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}, "remote_url_classification": {"enum": ["github_https", "github_ssh"]}}},
    "issue": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["number", "state", "title", "observed_at"], "properties": {"number": {"type": "integer", "minimum": 1}, "state": {"type": ["string", "null"]}, "title": {"type": ["string", "null"]}, "observed_at": {"$ref": "#/$defs/time"}}}]},
    "git": {"type": "object", "additionalProperties": false, "required": ["authoritative_main_branch", "expected_main_sha", "local_main_sha", "remote_tracking_main_sha", "live_remote_main_sha", "current_branch", "current_head_sha", "base_sha", "dirty", "staged", "unstaged", "untracked"], "properties": {"authoritative_main_branch": {"type": "string"}, "expected_main_sha": {"type": ["string", "null"]}, "local_main_sha": {"$ref": "#/$defs/sha"}, "remote_tracking_main_sha": {"$ref": "#/$defs/sha"}, "live_remote_main_sha": {"$ref": "#/$defs/sha"}, "current_branch": {"type": "string"}, "current_head_sha": {"$ref": "#/$defs/sha"}, "base_sha": {"$ref": "#/$defs/sha"}, "dirty": {"type": "boolean"}, "staged": {"type": "boolean"}, "unstaged": {"type": "boolean"}, "untracked": {"type": "boolean"}}},
    "branch_ownership": {"type": "object", "additionalProperties": false, "required": ["local_branch", "live_remote_branch_exists", "live_remote_branch_sha", "stale_local_remote_tracking_ref_exists", "stale_local_remote_tracking_ref_sha", "open_prs_for_branch", "historical_closed_or_merged_prs_for_branch", "prs_for_exact_current_head", "classification"], "properties": {"local_branch": {"type": "string"}, "live_remote_branch_exists": {"type": "boolean"}, "live_remote_branch_sha": {"type": ["string", "null"]}, "stale_local_remote_tracking_ref_exists": {"type": "boolean"}, "stale_local_remote_tracking_ref_sha": {"type": ["string", "null"]}, "open_prs_for_branch": {"$ref": "#/$defs/numbers"}, "historical_closed_or_merged_prs_for_branch": {"$ref": "#/$defs/numbers"}, "prs_for_exact_current_head": {"$ref": "#/$defs/numbers"}, "classification": {"enum": ["ACTIVE_OWNERSHIP_CONFLICT", "EXISTING_EXACT_HEAD_PUBLICATION", "HISTORICAL_BRANCH_REUSE", "STALE_REMOTE_TRACKING_REF", "UNOWNED_CURRENT_HEAD"]}}},
    "pull_request": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["number", "state", "base_branch", "head_branch", "base_sha", "head_sha", "commit_count", "changed_file_count", "mergeability", "observed_at"], "properties": {"number": {"type": "integer"}, "state": {"type": ["string", "null"]}, "base_branch": {"type": ["string", "null"]}, "head_branch": {"type": ["string", "null"]}, "base_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "commit_count": {"type": ["integer", "null"]}, "changed_file_count": {"type": ["integer", "null"]}, "mergeability": {"type": ["string", "null"]}, "observed_at": {"$ref": "#/$defs/time"}}}]},
    "changed_files": {"type": "object", "additionalProperties": false, "required": ["branch_diff", "staged", "unstaged", "untracked", "ignored_risk_paths"], "properties": {"branch_diff": {"$ref": "#/$defs/paths"}, "staged": {"$ref": "#/$defs/paths"}, "unstaged": {"$ref": "#/$defs/paths"}, "untracked": {"$ref": "#/$defs/paths"}, "ignored_risk_paths": {"$ref": "#/$defs/paths"}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["required_names", "applicable_head_sha", "records", "status"], "properties": {"required_names": {"type": "array", "items": {"enum": ["validate", "docs-check", "fixtures", "security"]}}, "applicable_head_sha": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "records": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "head_sha", "expected_head_sha", "status", "conclusion", "run_id", "job_id", "observed_at"], "properties": {"name": {"type": "string"}, "head_sha": {"$ref": "#/$defs/sha"}, "expected_head_sha": {"$ref": "#/$defs/sha"}, "status": {"type": "string"}, "conclusion": {"type": ["string", "null"]}, "run_id": {"type": ["string", "null"]}, "job_id": {"type": ["string", "null"]}, "observed_at": {"$ref": "#/$defs/time"}}}}, "status": {"type": "string"}}},
    "worktrees": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "branch", "head_sha", "clean", "classification"], "properties": {"path": {"type": "string"}, "branch": {"type": ["string", "null"]}, "head_sha": {"type": ["string", "null"]}, "clean": {"type": "boolean"}, "classification": {"type": "string"}}}},
    "stash_protections": {"type": "object", "additionalProperties": false, "required": ["expected_identifiers", "observed_presence", "observed_identifiers", "contents_inspected"], "properties": {"expected_identifiers": {"$ref": "#/$defs/paths"}, "observed_presence": {"type": "boolean"}, "observed_identifiers": {"$ref": "#/$defs/paths"}, "contents_inspected": {"const": false}}},
    "classifications": {"type": "object", "additionalProperties": false, "required": ["findings"], "properties": {"findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "classification", "message", "source", "affected_identifier", "may_continue", "recovery_or_required_authority", "evidence"], "properties": {"code": {"type": "string"}, "classification": {"enum": ["INFORMATIONAL_DISCREPANCY", "RECOVERABLE_AUTOMATION_FAILURE", "AUTHORIZATION_BLOCKER", "DEPENDENCY_BLOCKER", "MATERIAL_IMPLEMENTATION_BLOCKER", "DESTRUCTIVE_ACTION_BLOCKER", "GOVERNED_BOUNDARY_REVIEW_REQUIRED"]}, "message": {"type": "string"}, "source": {"type": "string"}, "affected_identifier": {"type": ["string", "null"]}, "may_continue": {"type": "boolean"}, "recovery_or_required_authority": {"type": "string"}, "evidence": {"type": "object"}}}}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["collection_started_at", "collection_finished_at", "expected_vs_observed", "stale", "globally_atomic"], "properties": {"collection_started_at": {"$ref": "#/$defs/time"}, "collection_finished_at": {"$ref": "#/$defs/time"}, "expected_vs_observed": {"type": "object"}, "stale": {"type": "boolean"}, "globally_atomic": {"const": false}}},
    "next_legal_states": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"enum": ["local_git", "github_api"]}}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}, "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "numbers": {"type": "array", "items": {"type": ["integer", "null"]}}, "paths": {"type": "array", "items": {"type": "string"}}}
}
